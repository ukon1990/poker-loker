# Apache setup. Vite copies this file into dist/, so it deploys with the app.
# Needs mod_rewrite, and "AllowOverride All" (or at least FileInfo Indexes) for this folder.

DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Serve the app for routes like /play. Paths with a file extension stay
  # real 404s, so a missing script is never answered with HTML.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !\.[^/]+$
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_headers.c>
  # index.html, sw.js and the manifest must be rechecked, or updates never arrive.
  Header set Cache-Control "no-cache"

  # Files in assets/ have a content hash in their name, so they never change.
  <If "%{REQUEST_URI} =~ m#/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>
